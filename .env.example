# AIT SMART CAMPUS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local overrides. Never commit actual secret keys.

# Web Application Port & Host
VITE_APP_PORT=5173
VITE_APP_HOST=127.0.0.1

# Deployed Reachable HTTPS URL (Used by QR Code Generator)
# Scanning the QR code will open this exact HTTPS address directly without setup forms.
VITE_DEPLOYED_MOBILE_URL=https://ait-virtual-campus.vercel.app/mobile

# Optional External AI Chatbot Integration (OpenAI or Gemini API key)
# If left empty, the application uses the built-in intelligent rule-based campus knowledge engine.
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gemini-1.5-flash

# Default Lecture Parameters
VITE_DEFAULT_LECTURE_MINUTES=60
VITE_DEFAULT_ATTENDANCE_THRESHOLD_MINUTES=45
VITE_DEFAULT_THRESHOLD_POLICY=FLAG_FOR_REVIEW

# Camera Vision Emulation Latency (in milliseconds)
VITE_SIMULATED_VISION_LATENCY_MS=120
